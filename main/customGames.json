[{"title":"微博","description":"","category":"","icon":"📦","coverColor":"#4C7DF0","htmlContent":"<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>微博</title>\n\n  <script type=\"application/nuojiji-manifest\">\n{\n  \"id\": \"weibo-app-pro\",\n  \"version\": \"2.2.0\",\n  \"chrome\": \"none\",\n  \"permissions\": [\n    \"ai\",\n    \"media.read\",\n    \"chat.send\",\n    \"net\"\n  ],\n  \"net\": {\n    \"domains\": [\n      \"api.openai.com\",\n      \"api.deepseek.com\",\n      \"open.bigmodel.cn\",\n      \"api.moonshot.cn\",\n      \"api.groq.com\",\n      \"cf.eeaihub.com\"\n    ]\n  },\n  \"slots\": [\n    {\n      \"type\": \"floating\",\n      \"title\": \"微博\",\n      \"width\": 320,\n      \"height\": 500\n    }\n  ],\n  \"source\": \"locked\"\n}\n</script>\n\n  <style>\n    :root {\n      --bg: #f2f2f2;\n      --card: #ffffff;\n      --text: #333333;\n      --sub: #999999;\n      --accent: #ff8200;\n      --red: #e6162d;\n      --blue: #1da1f2;\n      --border: #e7e7e7;\n      --safe-top: env(safe-area-inset-top, 0px);\n      --safe-bottom: env(safe-area-inset-bottom, 0px);\n    }\n    @media (prefers-color-scheme: dark) {\n      :root {\n        --bg: #121212;\n        --card: #1e1e1e;\n        --text: #eeeeee;\n        --sub: #888888;\n        --border: #2c2c2c;\n      }\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\n    body { font-family: -apple-system, \"PingFang SC\", sans-serif; background: var(--bg); color: var(--text); padding-bottom: calc(64px + var(--safe-bottom)); min-height: 100vh; }\n    input, textarea, button, select { font-size: 16px; font-family: inherit; }\n    button { cursor: pointer; }\n\n    /* 顶栏 */\n    .topbar {\n      position: sticky; top: 0; z-index: 50;\n      display: flex; align-items: center; justify-content: space-between;\n      padding: calc(var(--safe-top) + 10px) 14px 10px;\n      background: var(--card); color: var(--text);\n      box-shadow: 0 1px 0 var(--border);\n    }\n    .back-btn, .top-settings { border: none; background: transparent; color: var(--text); font-size: 24px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }\n    .topbar-title { font-size: 17px; font-weight: 700; }\n\n    /* 底部导航 */\n    .tabs {\n      position: fixed; left: 0; right: 0; bottom: 0; z-index: 100;\n      height: calc(54px + var(--safe-bottom)); padding-bottom: var(--safe-bottom);\n      display: flex; background: rgba(255,255,255,.98); border-top: 1px solid var(--border);\n    }\n    @media (prefers-color-scheme: dark) { .tabs { background: rgba(30,30,30,.98); } }\n    .tab {\n      flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;\n      border: none; background: none; color: var(--sub); font-size: 10px; gap: 3px;\n    }\n    .tab.active { color: var(--text); font-weight: 700; }\n    .nav-icon { font-size: 22px; line-height: 1; }\n    .publish-circle {\n      width: 44px; height: 34px; border-radius: 12px;\n      background: var(--accent); color: #fff;\n      display: flex; align-items: center; justify-content: center;\n      font-size: 24px; font-weight: bold; box-shadow: 0 2px 8px rgba(255,130,0,.3);\n    }\n\n    /* 页面容器 */\n    .page { display: none; }\n    .page.active { display: block; }\n\n    /* 通用模块 */\n    .section-label { padding: 12px 14px 8px; background: var(--card); border-bottom: 1px solid var(--border); color: var(--sub); font-size: 12px; }\n    \n    /* 热搜 */\n    .hot-item { display: flex; align-items: center; gap: 12px; background: var(--card); padding: 14px; border-bottom: 1px solid var(--border); }\n    .rank { width: 24px; height: 24px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; color: #fff; background: var(--sub); }\n    .rank-1 { background: #e6162d; } .rank-2 { background: #ff6b35; } .rank-3 { background: #ffb020; }\n    .hot-info { flex: 1; min-width: 0; }\n    .hot-title { font-size: 15px; font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .hot-meta { font-size: 12px; color: var(--sub); margin-top: 4px; }\n    .hot-tag { font-size: 10px; padding: 2px 4px; border-radius: 3px; font-weight: 700; }\n    .tag-hot { background: #fff0f0; color: #e6162d; } .tag-new { background: #f0fff4; color: #059669; } .tag-boom { background: #fff7ed; color: #d97706; }\n\n    /* 微博流 (首页/个人主页) */\n    .weibo-post { background: var(--card); padding: 14px; margin-bottom: 8px; }\n    .post-user { display: flex; gap: 10px; align-items: center; }\n    .post-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: #eee; }\n    .post-user-info { flex: 1; }\n    .post-name { font-size: 15px; font-weight: 700; color: var(--accent); }\n    .post-time { font-size: 11px; color: var(--sub); margin-top: 2px; }\n    .post-text { font-size: 16px; line-height: 1.6; margin: 10px 0; white-space: pre-wrap; word-break: break-word; }\n    .weibo-tag { color: var(--blue); cursor: pointer; }\n    .post-actions { display: flex; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 10px; margin-top: 10px; }\n    .action-btn { flex: 1; border: none; background: none; color: var(--sub); font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 4px; transition: color .2s; }\n    .action-btn:active { color: var(--accent); }\n\n    /* 发博页 */\n    .compose-header { padding: 14px; font-size: 13px; font-weight: 700; color: var(--sub); background: var(--card); border-bottom: 1px solid var(--border); }\n    .compose-area { width: 100%; border: none; padding: 14px; font-size: 16px; background: var(--card); color: var(--text); resize: none; outline: none; min-height: 150px; }\n    .compose-footer { background: var(--card); padding: 0 14px 14px; }\n    .char-count { text-align: right; font-size: 13px; color: var(--sub); margin-bottom: 10px; }\n    .compose-tools { display: flex; gap: 10px; }\n    .tool-btn { padding: 8px 16px; border-radius: 20px; font-size: 14px; font-weight: 700; border: none; display: flex; align-items: center; gap: 4px; }\n    .btn-ai { background: #e6162d; color: #fff; }\n    .btn-tag { background: #fff; color: #e6162d; border: 1px solid #e6162d; }\n    .btn-pub { background: #059669; color: #fff; margin-left: auto; }\n\n    /* 消息页 */\n    .msg-list { background: var(--card); }\n    .msg-item { display: flex; align-items: center; gap: 12px; padding: 14px; border-bottom: 1px solid var(--border); }\n    .msg-avatar { width: 48px; height: 48px; border-radius: 50%; background: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24px; }\n    .msg-content { flex: 1; }\n    .msg-name { font-size: 16px; font-weight: 700; }\n    .msg-desc { font-size: 13px; color: var(--sub); margin-top: 4px; }\n\n    /* 个人主页 */\n    .profile-cover { height: 160px; background: linear-gradient(135deg, #ffd9df, #f5c9d1 45%, #d8e9f7); position: relative; background-size: cover; background-position: center; }\n    .cover-edit-btn { position: absolute; right: 12px; bottom: 12px; background: rgba(0,0,0,.4); color: #fff; border: 1px solid rgba(255,255,255,.5); padding: 4px 10px; border-radius: 4px; font-size: 11px; }\n    .profile-main { background: var(--card); padding: 0 16px 14px; position: relative; margin-bottom: 8px; }\n    .avatar-wrap { position: absolute; left: 16px; top: -36px; width: 76px; height: 76px; }\n    .profile-avatar { width: 100%; height: 100%; border-radius: 50%; border: 3px solid var(--card); object-fit: cover; background: #eee; }\n    .profile-actions { height: 48px; display: flex; justify-content: flex-end; align-items: center; }\n    .btn-edit-profile { border: 1px solid var(--border); background: var(--card); color: var(--text); padding: 6px 14px; border-radius: 16px; font-size: 13px; font-weight: 700; }\n    .profile-name { font-size: 20px; font-weight: 800; display: flex; align-items: center; gap: 6px; margin-top: 4px; }\n    .v-badge { background: var(--accent); color: #fff; font-size: 10px; width: 16px; height: 16px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; }\n    .profile-id { font-size: 12px; color: var(--sub); margin-top: 4px; }\n    .profile-bio { font-size: 13px; margin-top: 8px; }\n    .profile-stats { display: flex; gap: 20px; margin-top: 12px; font-size: 14px; }\n    .profile-stats strong { font-size: 16px; }\n    .profile-tabs { display: flex; background: var(--card); border-bottom: 1px solid var(--border); position: sticky; top: 52px; z-index: 10; }\n    .ptab { flex: 1; text-align: center; padding: 12px 0; font-size: 14px; font-weight: 700; color: var(--sub); border-bottom: 2px solid transparent; }\n    .ptab.active { color: var(--text); border-bottom-color: var(--red); }\n\n    /* API 设置页 */\n    .provider-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px; background: var(--card); }\n    .provider-card { border: 2px solid var(--border); border-radius: 12px; padding: 12px 10px; text-align: center; background: var(--bg); transition: all .2s; }\n    .provider-card.selected { border-color: var(--accent); background: #fff0f0; }\n    @media (prefers-color-scheme: dark) { .provider-card.selected { background: #2a1010; } }\n    .p-icon { font-size: 24px; margin-bottom: 4px; }\n    .p-name { font-size: 13px; font-weight: 700; }\n    .p-model { font-size: 11px; color: var(--sub); margin-top: 2px; }\n\n    .ios-group { background: var(--card); margin-bottom: 12px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }\n    .ios-item { display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border); }\n    .ios-item:last-child { border-bottom: none; }\n    .ios-icon { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 16px; margin-right: 12px; }\n    .ios-label { font-size: 15px; width: 80px; font-weight: 600; }\n    .ios-input { flex: 1; border: none; background: transparent; color: var(--text); font-size: 15px; outline: none; text-align: right; }\n    .ios-actions { display: flex; background: var(--card); border-bottom: 1px solid var(--border); }\n    .ios-action-btn { flex: 1; padding: 14px 0; border: none; background: transparent; color: #007aff; font-size: 15px; font-weight: 700; border-right: 1px solid var(--border); }\n    .ios-action-btn:last-child { border-right: none; }\n\n    /* 弹窗 */\n    .modal { display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,.5); align-items: flex-end; }\n    .modal.show { display: flex; }\n    .modal-content { width: 100%; background: var(--card); border-radius: 16px 16px 0 0; padding: 20px; max-height: 80vh; overflow-y: auto; }\n    .modal-header { display: flex; justify-content: space-between; font-size: 16px; font-weight: 700; margin-bottom: 16px; }\n    .modal-close { border: none; background: none; font-size: 20px; color: var(--sub); }\n    .modal-input { width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 12px; background: var(--bg); color: var(--text); }\n    .modal-btn { width: 100%; padding: 12px; background: var(--accent); color: #fff; border: none; border-radius: 8px; font-weight: 700; margin-top: 10px; }\n\n    #toast { position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,.8); color: #fff; padding: 10px 20px; border-radius: 20px; font-size: 14px; opacity: 0; transition: opacity .2s; z-index: 9999; pointer-events: none; }\n    #toast.show { opacity: 1; }\n  </style>\n</head>\n<body>\n\n<!-- 顶栏 -->\n<div class=\"topbar\">\n  <button class=\"back-btn\" onclick=\"Nuojiji.close()\">‹</button>\n  <span class=\"topbar-title\">微博</span>\n  <button class=\"top-settings\" onclick=\"switchTab('settings')\">⚙</button>\n</div>\n\n<!-- 底部导航 -->\n<div class=\"tabs\">\n  <button class=\"tab active\" onclick=\"switchTab('home')\"><span class=\"nav-icon\">⌂</span><span>首页</span></button>\n  <button class=\"tab\" onclick=\"switchTab('hot')\"><span class=\"nav-icon\">⌕</span><span>热搜</span></button>\n  <button class=\"tab\" onclick=\"switchTab('compose')\"><span class=\"publish-circle\">＋</span></button>\n  <button class=\"tab\" onclick=\"switchTab('msg')\"><span class=\"nav-icon\">✉</span><span>消息</span></button>\n  <button class=\"tab\" onclick=\"switchTab('me')\"><span class=\"nav-icon\">👤</span><span>我</span></button>\n</div>\n\n<!-- ===== 首页 (信息流) ===== -->\n<div class=\"page active\" id=\"page-home\">\n  <div id=\"home-feed\"></div>\n</div>\n\n<!-- ===== 热搜榜 ===== -->\n<div class=\"page\" id=\"page-hot\">\n  <div class=\"section-label\">今日热搜 · 实时更新</div>\n  <div id=\"hot-list\"></div>\n</div>\n\n<!-- ===== 发博 ===== -->\n<div class=\"page\" id=\"page-compose\">\n  <div class=\"compose-header\">写微博（140字）</div>\n  <textarea class=\"compose-area\" id=\"post-text\" placeholder=\"有什么新鲜事？\" maxlength=\"140\" oninput=\"updateCount()\"></textarea>\n  <div class=\"compose-footer\">\n    <div class=\"char-count\"><span id=\"char-count\">0</span> / 140</div>\n    <div class=\"compose-tools\">\n      <button class=\"tool-btn btn-ai\" onclick=\"polishPost()\">🪄 AI 润色</button>\n      <button class=\"tool-btn btn-tag\" onclick=\"addHashtag()\"># 加话题</button>\n      <button class=\"tool-btn btn-pub\" onclick=\"publishPost()\">📤 发布微博</button>\n    </div>\n  </div>\n</div>\n\n<!-- ===== 消息 ===== -->\n<div class=\"page\" id=\"page-msg\">\n  <div class=\"msg-list\">\n    <div class=\"msg-item\" onclick=\"chatWithChar()\">\n      <div class=\"msg-avatar\">💬</div>\n      <div class=\"msg-content\">\n        <div class=\"msg-name\">当前聊天角色</div>\n        <div class=\"msg-desc\">点击将最新的一条微博发送给TA</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ===== 个人主页 ===== -->\n<div class=\"page\" id=\"page-me\">\n  <div class=\"profile-cover\" id=\"profile-cover\">\n    <button class=\"cover-edit-btn\" onclick=\"pickImage('cover')\">✎ 编辑封面</button>\n  </div>\n  <div class=\"profile-main\">\n    <div class=\"avatar-wrap\" onclick=\"pickImage('avatar')\">\n      <img id=\"profile-avatar\" class=\"profile-avatar\" src=\"\" alt=\"\">\n    </div>\n    <div class=\"profile-actions\">\n      <button class=\"btn-edit-profile\" onclick=\"openProfileEditor()\">编辑资料</button>\n    </div>\n    <div class=\"profile-name\">\n      <span id=\"profile-name\">我的微博</span>\n      <span class=\"v-badge\">V</span>\n    </div>\n    <div id=\"profile-id\" class=\"profile-id\">微博ID：my_weibo_001</div>\n    <div class=\"profile-bio\">📍 个人主页</div>\n    <div id=\"profile-bio\" class=\"profile-bio\" style=\"color:var(--sub)\">专注分享生活</div>\n    <div class=\"profile-stats\">\n      <span><strong id=\"stat-posts\">0</strong> 博文</span>\n      <span><strong id=\"stat-following\">20</strong> 关注</span>\n      <span><strong id=\"stat-followers\">100,000</strong> 粉丝</span>\n    </div>\n  </div>\n  \n  <div class=\"profile-tabs\">\n    <div class=\"ptab active\">博文</div>\n    <div class=\"ptab\">关注</div>\n    <div class=\"ptab\">粉丝</div>\n  </div>\n  <div id=\"my-posts\"></div>\n</div>\n\n<!-- ===== API 设置 ===== -->\n<div class=\"page\" id=\"page-settings\">\n  <div class=\"section-label\">选择 API 提供商</div>\n  <div class=\"provider-grid\" id=\"provider-grid\"></div>\n\n  <div class=\"section-label\">连接配置 (内置AI无需填写)</div>\n  <div class=\"ios-group\" id=\"config-group\">\n    <div class=\"ios-item\">\n      <div class=\"ios-icon\" style=\"background:#74b9ff\">🌐</div>\n      <div class=\"ios-label\">API 地址</div>\n      <input class=\"ios-input\" id=\"cfg-base-url\" placeholder=\"https://api.openai.com/v1\">\n    </div>\n    <div class=\"ios-item\">\n      <div class=\"ios-icon\" style=\"background:#55efc4\">🔑</div>\n      <div class=\"ios-label\">API 密钥</div>\n      <input class=\"ios-input\" id=\"cfg-api-key\" type=\"password\" placeholder=\"sk-...\">\n    </div>\n    <div class=\"ios-item\">\n      <div class=\"ios-icon\" style=\"background:#a29bfe\">🤖</div>\n      <div class=\"ios-label\">选择模型</div>\n      <input class=\"ios-input\" id=\"cfg-model\" placeholder=\"gpt-4o-mini\">\n    </div>\n  </div>\n  <div class=\"ios-actions\" id=\"action-group\">\n    <button class=\"ios-action-btn\" onclick=\"fetchModels()\">🔄 拉取模型</button>\n    <button class=\"ios-action-btn\" onclick=\"testConnection()\">🔗 链接测试</button>\n  </div>\n  <div class=\"ios-group\" style=\"margin-top:20px\">\n    <div class=\"ios-item\">\n      <button style=\"width:100%; text-align:center; color:#e6162d; background:none; border:none; font-size:16px; font-weight:700;\" onclick=\"saveConfig()\">保存配置</button>\n    </div>\n  </div>\n</div>\n\n<!-- 资料编辑弹窗 -->\n<div class=\"modal\" id=\"modal-profile\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\"><span>编辑资料</span><button class=\"modal-close\" onclick=\"closeModal('modal-profile')\">×</button></div>\n    <input class=\"modal-input\" id=\"edit-name\" placeholder=\"昵称\">\n    <input class=\"modal-input\" id=\"edit-id\" placeholder=\"微博ID\">\n    <input class=\"modal-input\" id=\"edit-bio\" placeholder=\"简介\">\n    <input class=\"modal-input\" id=\"edit-following\" type=\"number\" placeholder=\"关注数\">\n    <input class=\"modal-input\" id=\"edit-followers\" type=\"number\" placeholder=\"粉丝数\">\n    <button class=\"modal-btn\" onclick=\"saveProfile()\">保存资料</button>\n  </div>\n</div>\n\n<input type=\"file\" id=\"file-input\" accept=\"image/*\" style=\"display:none\" onchange=\"handleFile(event)\">\n<div id=\"toast\"></div>\n\n<script>\n/* ============================================================\n   基础数据与状态\n   ============================================================ */\nconst PROVIDERS = [\n  { id: 'nuo', icon: '🐣', name: '内置 AI', model: '默认', baseUrl: '' },\n  { id: 'openai', icon: '🟢', name: 'OpenAI', model: 'gpt-4o-mini', baseUrl: 'https://api.openai.com/v1' },\n  { id: 'deepseek', icon: '🔵', name: 'DeepSeek', model: 'deepseek-chat', baseUrl: 'https://api.deepseek.com/v1' },\n  { id: 'anthropic', icon: '🟠', name: 'Anthropic', model: 'claude-sonnet-4-6', baseUrl: 'https://api.anthropic.com/v1' },\n  { id: 'zhipu', icon: '🟣', name: '智谱 GLM', model: 'glm-4-flash', baseUrl: 'https://open.bigmodel.cn/api/paas/v4' },\n  { id: 'custom', icon: '🔧', name: '自定义', model: 'gpt-4o-mini', baseUrl: 'https://cf.eeaihub.com/v1' }\n];\n\nconst HOT_DATA = [\n  { rank:1, title:'AI助手全面进入日常生活', heat:'2456万', tag:'hot' },\n  { rank:2, title:'北京今日最高气温38度', heat:'1893万', tag:'hot' },\n  { rank:3, title:'新能源汽车销量再创新高', heat:'1672万', tag:'boom' },\n  { rank:4, title:'《黑神话：悟空》续作传闻', heat:'1401万', tag:'new' },\n  { rank:5, title:'林祁居然被女生爆出轨约炮？！', heat:'1234万', tag:'boom' },\n  { rank:6, title:'中国女排夺冠', heat:'1102万', tag:'boom' },\n];\n\nlet MY_POSTS = [];\nlet HOME_POSTS = [\n  { id: 1, name: '京市新闻', avatar: '', time: '09/04 02:30', text: '#林祁居然被女生爆出轨约炮？！# \\n\\n据知情人透露，当红小生林祁昨夜被拍到与神秘女子出入酒店...', likes: 1205, comments: 342, isV: true },\n  { id: 2, name: '科技前沿', avatar: '', time: '1小时前', text: '全新一代AI芯片发布，算力提升300%！#科技改变生活#', likes: 890, comments: 120, isV: true }\n];\n\nlet imageTarget = ''; \nlet currentProviderId = 'nuo';\n\n/* ============================================================\n   初始化与 Tab 切换\n   ============================================================ */\nasync function init() {\n  loadConfig();\n  await loadProfileData();\n  renderProviderGrid();\n  renderHot();\n  renderHome();\n  renderMyPosts();\n}\n\nfunction switchTab(name) {\n  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));\n  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));\n  \n  const tabMap = { 'home':0, 'hot':1, 'compose':2, 'msg':3, 'me':4, 'settings':-1 };\n  if(tabMap[name] >= 0) document.querySelectorAll('.tab')[tabMap[name]].classList.add('active');\n  document.getElementById(`page-${name}`).classList.add('active');\n}\n\n/* ============================================================\n   渲染逻辑 (高亮蓝字、长按修改)\n   ============================================================ */\nfunction formatText(text) {\n  return text.replace(/#([^#]+)#/g, '<span class=\"weibo-tag\">#$1#</span>');\n}\n\n// 修复 SVG 编码导致的截断问题\nfunction getAvatar(post) {\n  if (post.avatar) return post.avatar;\n  const nameChar = (post.name || '我').charAt(0);\n  const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\"><rect width=\"40\" height=\"40\" fill=\"#e0e0e0\"/><text x=\"20\" y=\"26\" text-anchor=\"middle\" font-size=\"18\" fill=\"#666\">${nameChar}</text></svg>`;\n  return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;\n}\n\nlet pressTimer;\nfunction onLongPressStart(callback) { pressTimer = setTimeout(callback, 600); }\nfunction onLongPressEnd() { clearTimeout(pressTimer); }\n\nfunction renderPostHTML(post, isHome = false, index) {\n  const avatarSrc = getAvatar(post);\n  const vBadge = post.isV ? `<span class=\"v-badge\" style=\"width:14px;height:14px;font-size:8px;\">V</span>` : '';\n  \n  return `\n    <div class=\"weibo-post\">\n      <div class=\"post-user\">\n        <img class=\"post-avatar\" src=\"${avatarSrc}\">\n        <div class=\"post-user-info\">\n          <div class=\"post-name\">${post.name} ${vBadge}</div>\n          <div class=\"post-time\">${post.time} · 来自微博</div>\n        </div>\n      </div>\n      <div class=\"post-text\">${formatText(post.text)}</div>\n      <div class=\"post-actions\">\n        <button class=\"action-btn\">↗ 转发</button>\n        <button class=\"action-btn\" \n          onmousedown=\"onLongPressStart(()=>editStat(${index}, 'comments', ${isHome}))\" onmouseup=\"onLongPressEnd()\" onmouseleave=\"onLongPressEnd()\"\n          ontouchstart=\"onLongPressStart(()=>editStat(${index}, 'comments', ${isHome}))\" ontouchend=\"onLongPressEnd()\">\n          💬 ${post.comments}\n        </button>\n        <button class=\"action-btn\"\n          onmousedown=\"onLongPressStart(()=>editStat(${index}, 'likes', ${isHome}))\" onmouseup=\"onLongPressEnd()\" onmouseleave=\"onLongPressEnd()\"\n          ontouchstart=\"onLongPressStart(()=>editStat(${index}, 'likes', ${isHome}))\" ontouchend=\"onLongPressEnd()\">\n          ♡ ${post.likes}\n        </button>\n        <button class=\"action-btn\" onclick=\"generateComment(${index}, ${isHome})\">🤖 评论</button>\n      </div>\n    </div>\n  `;\n}\n\nfunction renderHome() {\n  document.getElementById('home-feed').innerHTML = HOME_POSTS.map((p, i) => renderPostHTML(p, true, i)).join('');\n}\n\nfunction renderMyPosts() {\n  document.getElementById('stat-posts').textContent = MY_POSTS.length;\n  const html = MY_POSTS.length ? MY_POSTS.map((p, i) => renderPostHTML(p, false, i)).join('') : '<div style=\"padding:40px;text-align:center;color:#999\">暂无博文</div>';\n  document.getElementById('my-posts').innerHTML = html;\n}\n\nfunction renderHot() {\n  document.getElementById('hot-list').innerHTML = HOT_DATA.map(item => `\n    <div class=\"hot-item\" onclick=\"document.getElementById('post-text').value += '#${item.title}# '; switchTab('compose');\">\n      <div class=\"rank rank-${item.rank}\">${item.rank}</div>\n      <div class=\"hot-info\">\n        <div class=\"hot-title\">${item.title}</div>\n        <div class=\"hot-meta\">${item.heat} 次讨论</div>\n      </div>\n      <span class=\"hot-tag tag-${item.tag}\">${item.tag === 'hot'?'热':item.tag==='boom'?'爆':'新'}</span>\n    </div>`).join('');\n}\n\n/* ============================================================\n   交互功能 (长按修改、AI 评论、发博)\n   ============================================================ */\nfunction editStat(index, field, isHome) {\n  const arr = isHome ? HOME_POSTS : MY_POSTS;\n  const newVal = prompt(`修改${field === 'likes' ? '点赞' : '评论'}数：`, arr[index][field]);\n  if(newVal !== null && !isNaN(newVal)) {\n    arr[index][field] = parseInt(newVal);\n    isHome ? renderHome() : renderMyPosts();\n    if(!isHome) saveProfileData();\n    toast('修改成功');\n  }\n}\n\nasync function generateComment(index, isHome) {\n  const arr = isHome ? HOME_POSTS : MY_POSTS;\n  const post = arr[index];\n  toast('AI 正在思考评论...');\n  \n  const reply = await callAI(`请根据以下微博正文，生成一条简短、接地气的网友评论（20字以内）：\\n${post.text}`);\n  if(reply) {\n    alert(`AI 评论：\\n${reply}`);\n    arr[index].comments += 1;\n    isHome ? renderHome() : renderMyPosts();\n    if(!isHome) saveProfileData();\n  }\n}\n\nfunction updateCount() {\n  document.getElementById('char-count').textContent = document.getElementById('post-text').value.length;\n}\n\nfunction publishPost() {\n  const text = document.getElementById('post-text').value.trim();\n  if(!text) return toast('写点什么吧');\n  \n  const p = JSON.parse(localStorage.getItem('wb_profile') || '{}');\n  MY_POSTS.unshift({\n    name: p.name || '我的微博',\n    avatar: p.avatar || '',\n    time: '刚刚',\n    text: text,\n    likes: 0, comments: 0, isV: true\n  });\n  \n  document.getElementById('post-text').value = '';\n  updateCount();\n  saveProfileData();\n  renderMyPosts();\n  switchTab('me');\n  toast('发布成功');\n}\n\nasync function polishPost() {\n  const text = document.getElementById('post-text').value;\n  if(!text) return toast('请先输入内容');\n  toast('润色中...');\n  const res = await callAI(`请润色这条微博文案，使其更生动，可以加点emoji，直接返回正文：\\n${text}`);\n  if(res) { document.getElementById('post-text').value = res; updateCount(); }\n}\n\nasync function addHashtag() {\n  const text = document.getElementById('post-text').value;\n  if(!text) return toast('请先输入内容');\n  toast('生成话题中...');\n  const res = await callAI(`根据以下内容，生成1-2个合适的微博话题标签（格式：#话题#），直接返回标签：\\n${text}`);\n  if(res) { document.getElementById('post-text').value += ` ${res}`; updateCount(); }\n}\n\n/* ============================================================\n   消息联动\n   ============================================================ */\nasync function chatWithChar() {\n  if(!MY_POSTS.length) return toast('你还没有发过微博');\n  const latest = MY_POSTS[0].text;\n  try {\n    if(window.nuo && nuo.chat) {\n      await nuo.chat.send(`[分享了一条微博]\\n${latest}`);\n      toast('已发送给角色！');\n    } else {\n      toast('仅在聊天环境中可用');\n    }\n  } catch (e) { toast('发送失败: ' + e.message); }\n}\n\n/* ============================================================\n   个人资料与图片处理 (绕过 Canvas 污染，直接 ArrayBuffer 转 Base64)\n   ============================================================ */\nasync function loadProfileData() {\n  const p = JSON.parse(localStorage.getItem('wb_profile') || '{\"name\":\"京市新闻\",\"id\":\"my_weibo_001\",\"bio\":\"专注新闻\",\"following\":20,\"followers\":100000}');\n  document.getElementById('profile-name').textContent = p.name;\n  document.getElementById('profile-id').textContent = `微博ID：${p.id}`;\n  document.getElementById('profile-bio').textContent = p.bio;\n  document.getElementById('stat-following').textContent = p.following;\n  document.getElementById('stat-followers').textContent = p.followers;\n  \n  MY_POSTS = JSON.parse(localStorage.getItem('wb_posts') || '[]');\n  \n  let avatar = localStorage.getItem('wb_avatar');\n  let cover = localStorage.getItem('wb_cover');\n  \n  if(window.nuo && nuo.storage) {\n    const stAvatar = await nuo.storage.get('wb_avatar');\n    const stCover = await nuo.storage.get('wb_cover');\n    if(stAvatar) avatar = stAvatar;\n    if(stCover) cover = stCover;\n  }\n  \n  if(avatar) {\n    document.getElementById('profile-avatar').src = avatar;\n    p.avatar = avatar;\n    localStorage.setItem('wb_profile', JSON.stringify(p));\n  } else {\n    document.getElementById('profile-avatar').src = getAvatar(p);\n  }\n  \n  if(cover) {\n    document.getElementById('profile-cover').style.backgroundImage = `url(${cover})`;\n  }\n}\n\nfunction saveProfileData() {\n  const p = {\n    name: document.getElementById('profile-name').textContent,\n    id: document.getElementById('profile-id').textContent.replace('微博ID：',''),\n    bio: document.getElementById('profile-bio').textContent,\n    following: document.getElementById('stat-following').textContent,\n    followers: document.getElementById('stat-followers').textContent,\n    avatar: document.getElementById('profile-avatar').src\n  };\n  localStorage.setItem('wb_profile', JSON.stringify(p));\n  localStorage.setItem('wb_posts', JSON.stringify(MY_POSTS));\n}\n\nfunction openProfileEditor() {\n  document.getElementById('edit-name').value = document.getElementById('profile-name').textContent;\n  document.getElementById('edit-id').value = document.getElementById('profile-id').textContent.replace('微博ID：','');\n  document.getElementById('edit-bio').value = document.getElementById('profile-bio').textContent;\n  document.getElementById('edit-following').value = document.getElementById('stat-following').textContent;\n  document.getElementById('edit-followers').value = document.getElementById('stat-followers').textContent;\n  document.getElementById('modal-profile').classList.add('show');\n}\n\nfunction saveProfile() {\n  document.getElementById('profile-name').textContent = document.getElementById('edit-name').value;\n  document.getElementById('profile-id').textContent = `微博ID：${document.getElementById('edit-id').value}`;\n  document.getElementById('profile-bio').textContent = document.getElementById('edit-bio').value;\n  document.getElementById('stat-following').textContent = document.getElementById('edit-following').value;\n  document.getElementById('stat-followers').textContent = document.getElementById('edit-followers').value;\n  saveProfileData();\n  closeModal('modal-profile');\n  renderMyPosts(); \n}\n\nfunction closeModal(id) { document.getElementById(id).classList.remove('show'); }\n\n// ArrayBuffer 转 Base64 核心函数（绕过 Canvas 跨域限制）\nfunction arrayBufferToBase64(buffer) {\n  let binary = '';\n  const bytes = new Uint8Array(buffer);\n  const len = bytes.byteLength;\n  for (let i = 0; i < len; i++) {\n    binary += String.fromCharCode(bytes[i]);\n  }\n  return window.btoa(binary);\n}\n\nasync function pickImage(target) {\n  imageTarget = target;\n  if(window.nuo && nuo.media) {\n    try {\n      const f = await nuo.media.pick('image/*');\n      if(f) {\n        const buf = await nuo.media.read(f.id); // 获取原始二进制\n        const base64 = arrayBufferToBase64(buf);\n        const mime = f.type || 'image/jpeg';\n        const dataUrl = `data:${mime};base64,${base64}`;\n        saveImageToProfile(target, dataUrl);\n        return;\n      }\n    } catch(e) { console.warn(e); }\n  }\n  // 降级：使用 input 选图\n  document.getElementById('file-input').click();\n}\n\nfunction handleFile(e) {\n  const file = e.target.files[0];\n  if(!file) return;\n  const reader = new FileReader();\n  reader.onload = () => {\n    // 降级模式下使用 Canvas 压缩\n    compressAndSave(reader.result, imageTarget);\n  };\n  reader.readAsDataURL(file);\n}\n\nfunction compressAndSave(src, target) {\n  const img = new Image();\n  img.onload = () => {\n    const c = document.createElement('canvas');\n    const max = target === 'cover' ? 800 : 300;\n    let w = img.width, h = img.height;\n    if(w > max || h > max) { const r = Math.min(max/w, max/h); w*=r; h*=r; }\n    c.width = w; c.height = h;\n    c.getContext('2d').drawImage(img, 0, 0, w, h);\n    saveImageToProfile(target, c.toDataURL('image/jpeg', 0.8));\n  };\n  img.src = src;\n}\n\nasync function saveImageToProfile(target, dataUrl) {\n  if(target === 'avatar') {\n    document.getElementById('profile-avatar').src = dataUrl;\n    localStorage.setItem('wb_avatar', dataUrl);\n    if(window.nuo && nuo.storage) await nuo.storage.set('wb_avatar', dataUrl);\n    \n    const p = JSON.parse(localStorage.getItem('wb_profile') || '{}');\n    p.avatar = dataUrl;\n    localStorage.setItem('wb_profile', JSON.stringify(p));\n    \n    MY_POSTS.forEach(post => { if(post.name === p.name) post.avatar = dataUrl; });\n    saveProfileData();\n    renderMyPosts();\n  } else {\n    document.getElementById('profile-cover').style.backgroundImage = `url(${dataUrl})`;\n    localStorage.setItem('wb_cover', dataUrl);\n    if(window.nuo && nuo.storage) await nuo.storage.set('wb_cover', dataUrl);\n  }\n  toast('图片已更新');\n}\n\n/* ============================================================\n   API 配置与网络请求 (支持内置 AI)\n   ============================================================ */\nfunction renderProviderGrid() {\n  const grid = document.getElementById('provider-grid');\n  grid.innerHTML = PROVIDERS.map(p => `\n    <div class=\"provider-card ${currentProviderId === p.id ? 'selected' : ''}\" onclick=\"selectProvider('${p.id}')\">\n      <div class=\"p-icon\">${p.icon}</div>\n      <div class=\"p-name\">${p.name}</div>\n      <div class=\"p-model\">${p.model}</div>\n    </div>\n  `).join('');\n  \n  // 切换面板显示状态\n  if (currentProviderId === 'nuo') {\n    document.getElementById('config-group').style.display = 'none';\n    document.getElementById('action-group').style.display = 'none';\n  } else {\n    document.getElementById('config-group').style.display = 'block';\n    document.getElementById('action-group').style.display = 'flex';\n  }\n}\n\nfunction selectProvider(id) {\n  currentProviderId = id;\n  const p = PROVIDERS.find(x => x.id === id);\n  if (p.id !== 'nuo') {\n    document.getElementById('cfg-base-url').value = p.baseUrl;\n    document.getElementById('cfg-model').value = p.model;\n  }\n  renderProviderGrid();\n}\n\nfunction loadConfig() {\n  const cfg = JSON.parse(localStorage.getItem('wb_api') || '{}');\n  currentProviderId = cfg.providerId || 'nuo';\n  document.getElementById('cfg-base-url').value = cfg.url || 'https://cf.eeaihub.com/v1';\n  document.getElementById('cfg-api-key').value = cfg.key || '';\n  document.getElementById('cfg-model').value = cfg.model || 'gpt-4o-mini';\n}\n\nfunction saveConfig() {\n  const cfg = {\n    providerId: currentProviderId,\n    url: document.getElementById('cfg-base-url').value.trim(),\n    key: document.getElementById('cfg-api-key').value.trim(),\n    model: document.getElementById('cfg-model').value.trim()\n  };\n  if(currentProviderId !== 'nuo' && !cfg.key) return toast('请输入 API 密钥');\n  localStorage.setItem('wb_api', JSON.stringify(cfg));\n  toast('配置已保存');\n}\n\nasync function fetchModels() {\n  const url = document.getElementById('cfg-base-url').value.trim().replace(/\\/$/, '');\n  const key = document.getElementById('cfg-api-key').value.trim();\n  if(!key) return toast('请先输入 API 密钥');\n  \n  toast('拉取中...');\n  try {\n    const res = await fetch(`${url}/models`, { headers: { 'Authorization': `Bearer ${key}` } });\n    const data = await res.json();\n    if(data.data && data.data.length > 0) {\n      const models = data.data.map(m => m.id).join('\\n');\n      const chosen = prompt(`获取到以下模型，请输入你想使用的模型名称：\\n\\n${models}`, data.data[0].id);\n      if(chosen) document.getElementById('cfg-model').value = chosen;\n    } else {\n      toast('未能获取到模型列表');\n    }\n  } catch (e) {\n    toast('拉取失败，请检查地址或网络');\n  }\n}\n\nasync function testConnection() {\n  toast('测试中...');\n  const res = await callAI('回复\"ok\"');\n  if(res) toast('🔗 连接成功！');\n}\n\nasync function callAI(promptText) {\n  const cfg = JSON.parse(localStorage.getItem('wb_api') || '{}');\n  \n  // 1. 使用内置 AI\n  if (cfg.providerId === 'nuo' || !cfg.key) {\n    if (window.nuo && nuo.ai) {\n      try {\n        const res = await nuo.ai.chat([{ role: 'user', content: promptText }]);\n        return res.text;\n      } catch (e) {\n        toast('内置AI调用失败: ' + e.message);\n        return null;\n      }\n    } else {\n      toast('请先配置 API 密钥');\n      switchTab('settings');\n      return null;\n    }\n  }\n  \n  // 2. 使用自定义 API\n  const url = (cfg.url || 'https://api.openai.com/v1').replace(/\\/$/, '');\n  try {\n    const res = await fetch(`${url}/chat/completions`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${cfg.key}` },\n      body: JSON.stringify({\n        model: cfg.model || 'gpt-4o-mini',\n        messages: [{ role: 'user', content: promptText }]\n      })\n    });\n    const data = await res.json();\n    if(data.choices && data.choices[0]) return data.choices[0].message.content;\n    toast('API 返回错误');\n    return null;\n  } catch (e) {\n    toast('请求失败: ' + e.message);\n    return null;\n  }\n}\n\nfunction toast(msg) {\n  const el = document.getElementById('toast');\n  el.textContent = msg; el.classList.add('show');\n  setTimeout(() => el.classList.remove('show'), 2000);\n}\n\n// 启动\ninit();\n</script>\n</body>\n</html>\n","usesAI":true,"author":"","landUploaderId":null,"landThreadId":null,"landAttId":"1go4mvelih5n5og","installedToHome":true,"entryKind":"app","requestedPermissions":["ai","media.read","chat.send","net"],"requestedNet":{"domains":["api.openai.com","api.deepseek.com","open.bigmodel.cn","api.moonshot.cn","api.groq.com","cf.eeaihub.com"]},"requestedSlots":[{"type":"floating","title":"微博","width":320,"height":500,"defaultOpen":true,"chrome":"host"}],"chrome":"none","sourceLocked":true,"permissions":["ai","media.read","chat.send","net"],"slots":[{"type":"floating","title":"微博","width":320,"height":500,"defaultOpen":true,"chrome":"host"}],"appId":"weibo-app-pro","version":"2.2.0","cspMode":"strict","createdAt":1790224827256,"id":1,"htmlRef":null,"net":{"domains":["api.openai.com","api.deepseek.com","open.bigmodel.cn","api.moonshot.cn","api.groq.com","cf.eeaihub.com"]}}]